# Copy to .env and fill in. .env is git-ignored — never commit real secrets.

# --- Public (safe in the browser) ---
NUXT_PUBLIC_SUPABASE_URL=https://wntedncojkxjtwvcecav.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only (SECRET) ---
# Supabase Dashboard -> Project Settings -> API Keys -> service_role / secret
NUXT_SUPABASE_SERVICE_ROLE_KEY=
# Resend Dashboard -> API Keys
NUXT_RESEND_API_KEY=
NUXT_EMAIL_FROM=KokoSend <no-reply@rechargify.org>
# Any long random string. Vercel Cron sends it to /api/cron/expiry-reminders.
CRON_SECRET=

# --- Supabase CLI (local only, used to apply database migrations) ---
# https://supabase.com/dashboard/account/tokens -> Generate new token
SUPABASE_ACCESS_TOKEN=
# The database password you set when creating the project
SUPABASE_DB_PASSWORD=
